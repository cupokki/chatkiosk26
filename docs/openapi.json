{
  "openapi": "3.0.3",
  "info": {
    "title": "AI Kiosk System API Specification",
    "description": "AI 키오스크 기반 스마트 주문 및 관리 시스템 API (Postman / Swagger Direct Import)",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:8080",
      "description": "Local Development Server"
    }
  ],
  "paths": {
    "/api/v1/stores": {
      "get": {
        "summary": "전체 활성 매장 목록 조회",
        "tags": ["Stores"],
        "responses": {
          "200": {
            "description": "성공"
          }
        }
      },
      "post": {
        "summary": "신규 매장 등록",
        "tags": ["Stores"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "강남점",
                "code": "STORE-001",
                "address": "서울시 강남구 테헤란로 123",
                "phone": "02-1234-5678"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "생성됨"
          }
        }
      }
    },
    "/api/v1/stores/{storeId}/categories": {
      "get": {
        "summary": "매장별 카테고리 목록 조회",
        "tags": ["Customer"],
        "parameters": [
          {
            "name": "storeId",
            "in": "path",
            "required": true,
            "schema": { "type": "integer" }
          }
        ],
        "responses": {
          "200": { "description": "성공" }
        }
      }
    },
    "/api/v1/stores/{storeId}/menus": {
      "get": {
        "summary": "매장별 고객용 메뉴 목록 조회",
        "tags": ["Customer"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "categoryId", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "성공" }
        }
      }
    },
    "/api/v1/stores/{storeId}/ai/cart-actions": {
      "post": {
        "summary": "LangChain 대화형 장바구니 조작",
        "tags": ["Customer"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "userMessage": "김치찌개 하나 담아주고 콜라는 빼줘",
                "currentCart": [
                  { "menuId": 2, "menuName": "콜라", "quantity": 1, "unitPrice": 2000 }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "성공" }
        }
      }
    },
    "/api/v1/stores/{storeId}/orders": {
      "post": {
        "summary": "주문 완료 및 결제 스텁",
        "tags": ["Customer"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "items": [
                  { "menuId": 1, "quantity": 2 },
                  { "menuId": 2, "quantity": 1 }
                ]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "생성됨" }
        }
      }
    },
    "/api/v1/admin/stores/{storeId}/menus": {
      "post": {
        "summary": "신규 메뉴 등록",
        "tags": ["Admin Menu"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "categoryId": 1,
                "name": "돈까스",
                "price": 10000,
                "description": "바삭한 등심 돈까스",
                "available": true,
                "tagIds": [1, 2]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "생성됨" }
        }
      },
      "get": {
        "summary": "QueryDSL 동적 메뉴 검색 (페이징)",
        "tags": ["Admin Menu"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "keyword", "in": "query", "schema": { "type": "string" } },
          { "name": "categoryId", "in": "query", "schema": { "type": "integer" } },
          { "name": "available", "in": "query", "schema": { "type": "boolean" } },
          { "name": "minPrice", "in": "query", "schema": { "type": "integer" } },
          { "name": "maxPrice", "in": "query", "schema": { "type": "integer" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "size", "in": "query", "schema": { "type": "integer", "default": 10 } }
        ],
        "responses": {
          "200": { "description": "성공" }
        }
      }
    },
    "/api/v1/admin/stores/{storeId}/menus/{menuId}": {
      "patch": {
        "summary": "메뉴 수정 및 상태 변경",
        "tags": ["Admin Menu"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "menuId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "example": {
                "name": "특제 김치찌개",
                "price": 9500,
                "available": false
              }
            }
          }
        },
        "responses": {
          "200": { "description": "성공" }
        }
      },
      "delete": {
        "summary": "메뉴 소프트 딜리트",
        "tags": ["Admin Menu"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "menuId", "in": "path", "required": true, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "성공" }
        }
      }
    },
    "/api/v1/admin/stores/{storeId}/statistics/sales": {
      "get": {
        "summary": "판매 통계 조회",
        "tags": ["Admin Statistics"],
        "parameters": [
          { "name": "storeId", "in": "path", "required": true, "schema": { "type": "integer" } },
          { "name": "startDate", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "endDate", "in": "query", "required": true, "schema": { "type": "string" } },
          { "name": "categoryId", "in": "query", "required": false, "schema": { "type": "integer" } }
        ],
        "responses": {
          "200": { "description": "성공" }
        }
      }
    }
  }
}
