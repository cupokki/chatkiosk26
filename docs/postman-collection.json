{
  "info": {
    "_postman_id": "chatkiosk26-api-collection",
    "name": "AI Kiosk System API Collection",
    "description": "AI 키오스크 기반 스마트 주문 및 관리 시스템 API 명세서 (Postman Direct Importable)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "storeId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. 매장 API (Stores)",
      "item": [
        {
          "name": "전체 매장 목록 조회",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores"]
            }
          },
          "response": []
        },
        {
          "name": "신규 매장 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"강남점\",\n  \"code\": \"STORE-001\",\n  \"address\": \"서울시 강남구 테헤란로 123\",\n  \"phone\": \"02-1234-5678\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "2. 고객 API (Customer)",
      "item": [
        {
          "name": "카테고리 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "categories"]
            }
          },
          "response": []
        },
        {
          "name": "판매 가능 메뉴 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/menus?categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "menus"],
              "query": [
                {
                  "key": "categoryId",
                  "value": "1",
                  "description": "카테고리 ID (선택사항)"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "AI 대화형 장바구니 조작 (LangChain)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userMessage\": \"김치찌개 하나 담아주고 콜라는 빼줘\",\n  \"currentCart\": [\n    {\n      \"menuId\": 2,\n      \"menuName\": \"콜라\",\n      \"quantity\": 1,\n      \"unitPrice\": 2000\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/ai/cart-actions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "ai", "cart-actions"]
            }
          },
          "response": []
        },
        {
          "name": "주문 완료 및 결제 스텁",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    {\n      \"menuId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"menuId\": 2,\n      \"quantity\": 1\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/stores/{{storeId}}/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "stores", "{{storeId}}", "orders"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "3. 관리자 API (Admin)",
      "item": [
        {
          "name": "신규 메뉴 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"categoryId\": 1,\n  \"name\": \"돈까스\",\n  \"price\": 10000,\n  \"description\": \"바삭하고 촉촉한 등심 돈까스\",\n  \"available\": true,\n  \"tagIds\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stores/{{storeId}}/menus",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stores", "{{storeId}}", "menus"]
            }
          },
          "response": []
        },
        {
          "name": "동적 메뉴 검색 (QueryDSL)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stores/{{storeId}}/menus?keyword=김치&categoryId=1&available=true&minPrice=5000&maxPrice=15000&page=0&size=10",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stores", "{{storeId}}", "menus"],
              "query": [
                { "key": "keyword", "value": "김치" },
                { "key": "categoryId", "value": "1" },
                { "key": "available", "value": "true" },
                { "key": "minPrice", "value": "5000" },
                { "key": "maxPrice", "value": "15000" },
                { "key": "page", "value": "0" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "메뉴 수정 및 상태 변경",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"특제 김치찌개\",\n  \"price\": 9500,\n  \"available\": false,\n  \"tagIds\": [1, 2]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stores/{{storeId}}/menus/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stores", "{{storeId}}", "menus", "1"]
            }
          },
          "response": []
        },
        {
          "name": "메뉴 소프트 딜리트",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stores/{{storeId}}/menus/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stores", "{{storeId}}", "menus", "1"]
            }
          },
          "response": []
        },
        {
          "name": "판매 통계 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/stores/{{storeId}}/statistics/sales?startDate=2026-08-01&endDate=2026-08-14&categoryId=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "stores", "{{storeId}}", "statistics", "sales"],
              "query": [
                { "key": "startDate", "value": "2026-08-01" },
                { "key": "endDate", "value": "2026-08-14" },
                { "key": "categoryId", "value": "1" }
              ]
            }
          },
          "response": []
        },
        {
          "name": "태그 목록 조회",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "tags"]
            }
          },
          "response": []
        },
        {
          "name": "신규 태그 등록",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"신메뉴\",\n  \"displayOrder\": 4\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/admin/tags",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "admin", "tags"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
